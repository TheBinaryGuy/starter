# Copied to .env by `bun run setup`, which fills in the secrets. Local development only.
APP_NAME=Starter
# Public origin for email links and auth requests. HTTPS outside localhost.
APP_ORIGIN=http://localhost:5173
# Optional app port (development, bun run start, or the Docker host port). Default: 5173.
# PORT=5173

POSTGRES_USER=starter
POSTGRES_PASSWORD=change-me
POSTGRES_DB=starter
POSTGRES_PORT=5434
DATABASE_URL=postgresql://starter:change-me@127.0.0.1:5434/starter
# Optional direct (non-pooled) database URL for migrations.
MIGRATION_DATABASE_URL=
# Optional base for test databases (<name>_test_<package>); defaults to DATABASE_URL.
# TEST_DATABASE_URL=

# Signs session cookies. Generated by setup; changing it signs everyone out.
BETTER_AUTH_SECRET=
# Behind a reverse proxy: the header with the client's address (x-forwarded-for, cf-connecting-ip).
TRUSTED_PROXY_HEADER=
# Social sign-in, each on when both values are set. Callback URLs:
#   <APP_ORIGIN>/api/auth/callback/github and <APP_ORIGIN>/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# smtp, resend, or log. Local SMTP is caught by Mailpit (http://localhost:8025).
EMAIL_ADAPTER=smtp
EMAIL_FROM="Starter <hello@starter.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
# Mailpit's ports on this machine, if 1025 and 8025 are taken.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_WEB_PORT=8025

# Extra origins the browser may connect to, for the Content Security Policy. Space or comma separated.
CSP_CONNECT_SRC=
